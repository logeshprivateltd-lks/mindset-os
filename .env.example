# OS Version & Identification
MINDSET_VERSION=0.1.0
MINDSET_ENVIRONMENT=development

# Local AI Engine (Ollama / llama.cpp)
OLLAMA_ENDPOINT=127.0.0.1:11434
DEFAULT_MODEL=qwen2.5:3b-instruct-q4_K_M

# MindSet Connect Cross-Device Gateway
MINDSET_CONNECT_PORT=7899
MINDSET_CONNECT_BIND=0.0.0.0

# User Data Storage Root (Default: ~/.mindset_data/)
MINDSET_DATA_DIR=~/.mindset_data

# Cryptographic Signatures
LKS_ED25519_ROOT_FINGERPRINT=LKS-ED25519-7F3A-8991-A9DE

# Debugging & Verbose Telemetry
MINDSET_DEBUG=false
RUST_LOG=info

