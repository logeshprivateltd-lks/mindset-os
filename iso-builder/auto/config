#!/bin/sh
# ==============================================================================
# MindSet OS — live-build auto/config definition
# Targets Debian 13 (Trixie) amd64 with UEFI (grub-efi) + BIOS (syslinux)
# ==============================================================================
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --linux-packages linux-image \
    --bootloaders "grub-efi,syslinux" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live components quiet splash username=live locales=en_US.UTF-8 keyboard-layouts=us" \
    --image-name "mindset-os" \
    --iso-application "MindSet OS" \
    --iso-publisher "LKS PVT LTD" \
    --iso-volume "MINDSET_OS" \
    --memtest none \
    --win32-loader false \
    --security false \
    --apt-recommends true \
    "${@}"
