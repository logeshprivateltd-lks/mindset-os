#!/bin/sh
# ==============================================================================
# MindSet OS — live-build auto/config definition
# Targets Debian 13 (Trixie) amd64 with UEFI (grub-efi) + BIOS (syslinux)
# ==============================================================================
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --linux-packages linux-image \
    --bootloaders "grub-efi,syslinux" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --bootappend-live "boot=live components quiet splash loglevel=3 systemd.show_status=auto fsck.mode=auto fsck.repair=yes hostname=mindset-os username=live locales=en_IN.UTF-8,en_US.UTF-8 keyboard-layouts=us timezone=Asia/Kolkata persistence" \
    --image-name "mindset-os" \
    --iso-application "MindSet OS V1.3" \
    --iso-publisher "L.K.S Company" \
    --iso-volume "MINDSET_OS_V1_3" \
    --memtest none \
    --win32-loader false \
    --security false \
    --apt-recommends true \
    "${@}"
