#!/bin/sh
# ==============================================================================
# MindSet OS — Smart GPU Probe & Pure-Rust Shell Supervision Launcher
# ==============================================================================

LOG_FILE="/tmp/mindset-shell.log"
exec >> "$LOG_FILE" 2>&1

echo "=========================================================="
echo " Starting MindSet OS Shell (Debian 13)"
echo " Launch Timestamp: $(date)"
echo "=========================================================="

export LC_ALL="C.UTF-8"
export LANG="C.UTF-8"
export RUST_BACKTRACE=1

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native"

VIRT_ENV="none"
if command -v systemd-detect-virt >/dev/null 2>&1; then
    VIRT_ENV="$(systemd-detect-virt || echo none)"
fi

HAS_VULKAN=false
if command -v vulkaninfo >/dev/null 2>&1 && vulkaninfo --summary >/dev/null 2>&1; then
    HAS_VULKAN=true
fi

if [ "$VIRT_ENV" != "none" ] && [ "$HAS_VULKAN" = false ]; then
    echo "[GPU Probe] VM without Vulkan ($VIRT_ENV) -> engaging tuned llvmpipe low-overhead mode"
    export WGPU_BACKEND="gl"
    export LIBGL_ALWAYS_SOFTWARE=1
    export MESA_LOADER_DRIVER_OVERRIDE="llvmpipe"
    export WGPU_POWER_PREF="low"
    export LP_NUM_THREADS="${LP_NUM_THREADS:-2}"
    export MINDSET_LOW_OVERHEAD=1
elif [ "$HAS_VULKAN" = true ]; then
    echo "[GPU Probe] Native Vulkan active -> engaging Vulkan hardware acceleration"
    export WGPU_BACKEND="vulkan"
else
    echo "[GPU Probe] Engaging EGL/OpenGL fallback"
    export WGPU_BACKEND="gl"
fi

if [ "${XDG_SESSION_TYPE:-}" = "x11" ] || [ -z "${WAYLAND_DISPLAY:-}" ]; then
    export WINIT_UNIX_BACKEND="x11"
else
    export WINIT_UNIX_BACKEND="wayland"
fi

BINARY_PATH=""
for candidate in /usr/local/bin/mindset-shell /opt/mindset-os/bin/mindset-shell /usr/local/bin/mindset-os /opt/mindset-os/bin/mindset-os; do
    if [ -x "$candidate" ]; then
        BINARY_PATH="$candidate"
        break
    fi
done

if [ -z "$BINARY_PATH" ]; then
    echo "ERROR: mindset-shell binary not found!"
    exit 1
fi

RESTART_COUNT=0
MAX_RESTARTS=3

while [ "$RESTART_COUNT" -lt "$MAX_RESTARTS" ]; do
    echo "[Launch] Starting $BINARY_PATH (backend=$WINIT_UNIX_BACKEND, attempt $((RESTART_COUNT + 1)))..."
    EXIT_CODE=0
    "$BINARY_PATH" || EXIT_CODE=$?

    if [ "$EXIT_CODE" -eq 0 ]; then
        echo "[Launch] mindset-shell exited cleanly."
        exit 0
    fi

    echo "[Launch WARNING] exited with status $EXIT_CODE"
    RESTART_COUNT=$((RESTART_COUNT + 1))

    if [ "$RESTART_COUNT" -eq 1 ]; then
        echo "[GPU Recovery] Switching to WGPU_BACKEND=gl + llvmpipe + low overhead"
        export WGPU_BACKEND="gl"
        export LIBGL_ALWAYS_SOFTWARE=1
        export MESA_LOADER_DRIVER_OVERRIDE="llvmpipe"
        export LP_NUM_THREADS=2
        export MINDSET_LOW_OVERHEAD=1
    elif [ "$RESTART_COUNT" -eq 2 ] && [ "$WINIT_UNIX_BACKEND" = "wayland" ] && [ -n "${DISPLAY:-}" ]; then
        echo "[Backend Recovery] Switching winit backend from wayland -> x11"
        export WINIT_UNIX_BACKEND="x11"
    fi
    sleep 1
done

echo "[Launch ERROR] mindset-shell failed $MAX_RESTARTS times (last exit=$EXIT_CODE)."
if [ "${XDG_CURRENT_DESKTOP:-}" = "labwc" ]; then
    pkill -TERM -x labwc 2>/dev/null || true
fi
exit "$EXIT_CODE"
