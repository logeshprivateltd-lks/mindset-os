[Desktop Entry]
Version=1.0
Name=YouTube Study
Comment=MindSet OS YouTube Study & Educational Lectures
GenericName=Video Player
Exec=chromium --app=https://www.youtube.com --class=YouTube --user-data-dir=%h/.local/share/mindset-os/youtube-app --no-first-run --no-default-browser-check
Terminal=false
X-MultipleArgs=false
Type=Application
Icon=youtube
Categories=AudioVideo;Video;Education;
StartupWMClass=YouTube
StartupNotify=true
