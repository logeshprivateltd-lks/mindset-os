// MindSet OS — Early Boot Animated Splash (Plymouth Script Plugin)
// Centered MS Monogram Emblem + Pre-cached Orbital Loading Spinner + Automatic Error/Status Display

Window.SetBackgroundTopColor(0.035, 0.043, 0.068);
Window.SetBackgroundBottomColor(0.020, 0.024, 0.040);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

// 1. Centered MindSet OS Emblem
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = (screen_w - logo.image.GetWidth()) / 2;
logo.y = (screen_h * 0.42) - (logo.image.GetHeight() / 2);
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(10);

// 2. Smooth Orbital Loading Ring (Pre-cached rotated sprites for low VM CPU usage)
spinner.base = Image("spinner.png");
spinner.sprite = Sprite();
spinner.frames = 36;
spinner.frame_idx = 0;
spinner.tick_div = 0;

spinner.x = (screen_w - spinner.base.GetWidth()) / 2;
spinner.y = logo.y + logo.image.GetHeight() + 26;
spinner.sprite.SetX(spinner.x);
spinner.sprite.SetY(spinner.y);
spinner.sprite.SetZ(10);

rotated_frames = [];
fun get_spinner_frame(idx) {
    if (!rotated_frames[idx]) {
        angle = (Math.Pi * 2 * idx) / spinner.frames;
        rotated_frames[idx] = spinner.base.Rotate(angle);
    }
    return rotated_frames[idx];
}

// Pre-warm rotation cache on startup
for (i = 0; i < spinner.frames; i++) {
    get_spinner_frame(i);
}
spinner.sprite.SetImage(get_spinner_frame(0));

// 3. Boot / Error Message Display
message_sprite = Sprite();
message_sprite.SetZ(20);

fun show_status_message(text) {
    if (!text || text == "") {
        message_sprite.SetOpacity(0);
        return;
    }
    img = Image.Text(text, 0.86, 0.90, 0.98, 1.0);
    if (img) {
        message_sprite.SetImage(img);
        message_sprite.SetX((screen_w - img.GetWidth()) / 2);
        message_sprite.SetY(spinner.y + spinner.base.GetHeight() + 22);
        message_sprite.SetOpacity(1);
    }
}

Plymouth.SetMessageFunction(show_status_message);

fun display_question_callback(prompt, entry) {
    show_status_message(prompt + " " + entry);
}
Plymouth.SetDisplayQuestionFunction(display_question_callback);

fun display_password_callback(prompt, bullets) {
    stars = "";
    for (i = 0; i < bullets; i++) {
        stars = stars + "*";
    }
    show_status_message(prompt + " " + stars);
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    message_sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// 4. Animation Loop (~25-30 FPS smooth rotation)
fun refresh_callback() {
    spinner.tick_div++;
    if (spinner.tick_div >= 2) {
        spinner.tick_div = 0;
        spinner.frame_idx = (spinner.frame_idx + 1) % spinner.frames;
        spinner.sprite.SetImage(get_spinner_frame(spinner.frame_idx));
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
    spinner.sprite.SetOpacity(0);
    logo.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
