#!/bin/bash
# ==============================================================================
# MindSet OS Live-Build Hook: 0200-services.hook.chroot
# Enables systemd services, PipeWire, NetworkManager & updates font cache
# ==============================================================================
set -e

echo "==> [MindSet Hook] Configuring system services..."

# Enable NetworkManager
if systemctl list-unit-files | grep -q "NetworkManager.service"; then
    systemctl enable NetworkManager.service || true
fi

# Enable Bluetooth
if systemctl list-unit-files | grep -q "bluetooth.service"; then
    systemctl enable bluetooth.service || true
fi

# Enable getty autologin override on tty1
systemctl daemon-reload || true
systemctl enable getty@tty1.service || true

# Update font caches for bundled Noto Tamil, Malayalam & English fonts
echo "==> [MindSet Hook] Refreshing font cache..."
if which fc-cache >/dev/null 2>&1; then
    fc-cache -f -v || true
fi

# Ensure executable permissions on custom scripts
chmod +x /usr/local/bin/mindset-os-launch 2>/dev/null || true
chmod +x /usr/local/bin/mindset-browser 2>/dev/null || true
chmod +x /usr/local/bin/mindset-os 2>/dev/null || true
chmod +x /opt/mindset-os/bin/mindset-os 2>/dev/null || true

echo "==> [MindSet Hook] Services and permissions configured."
