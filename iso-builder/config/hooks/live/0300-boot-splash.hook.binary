#!/bin/bash
# ==============================================================================
# MindSet OS Live-Build Hook: 0300-boot-splash.hook.binary
# Customizes GRUB UEFI & Legacy BIOS bootloader menus with MindSet branding
# ==============================================================================
set -e

echo "==> [MindSet Hook] Customizing GRUB & ISOLINUX boot splash menus..."

# Update GRUB configurations (UEFI + BIOS)
for cfg in binary/boot/grub/grub.cfg binary/EFI/BOOT/grub.cfg binary/boot/grub/loopback.cfg; do
    if [ -f "$cfg" ]; then
        echo "--> Branding $cfg..."
        sed -i 's/Debian GNU\/Linux/MindSet OS v1.0 (Debian 13) — Boot Deep Focus/g' "$cfg"
        sed -i 's/Live system/MindSet OS v1.0 (Debian 13) — Boot Deep Focus/g' "$cfg"
        sed -i 's/Debian/MindSet OS/g' "$cfg"
    fi
done

# Update ISOLINUX / SYSLINUX configurations
for cfg in binary/isolinux/*.cfg binary/syslinux/*.cfg; do
    if [ -f "$cfg" ]; then
        echo "--> Branding $cfg..."
        sed -i 's/Live system/MindSet OS v1.0 (Debian 13) — Boot Deep Focus/g' "$cfg"
        sed -i 's/Debian/MindSet OS/g' "$cfg"
    fi
done

echo "==> [MindSet Hook] Bootloader menus branded successfully."
