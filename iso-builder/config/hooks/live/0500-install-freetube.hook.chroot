#!/bin/bash
# ==============================================================================
# MindSet OS Live-Build Hook: 0500-install-freetube.hook.chroot
# Installs FreeTube (Ad-Free & Distraction-Free YouTube Client) into Live ISO
# ==============================================================================
set -e

echo "==> [MindSet Hook] Fetching latest FreeTube amd64.deb release..."

# Attempt to query GitHub API for the latest amd64.deb download URL
LATEST_DEB_URL=""
if which curl >/dev/null 2>&1; then
    LATEST_DEB_URL=$(curl -sL https://api.github.com/repos/FreeTubeApp/FreeTube/releases/latest 2>/dev/null | grep "browser_download_url.*amd64\.deb" | cut -d '"' -f 4 | head -n 1 || true)
fi

# Fallback known release URL if GitHub API rate-limited
if [ -z "$LATEST_DEB_URL" ]; then
    LATEST_DEB_URL="https://github.com/FreeTubeApp/FreeTube/releases/download/v0.23.2-beta/freetube_0.23.2_amd64.deb"
fi

echo "--> Downloading FreeTube from: $LATEST_DEB_URL"
curl -sSL "$LATEST_DEB_URL" -o /tmp/freetube.deb || {
    echo "Primary download failed, attempting secondary mirror..."
    curl -sSL "https://github.com/FreeTubeApp/FreeTube/releases/download/v0.22.1-beta/freetube_0.22.1_amd64.deb" -o /tmp/freetube.deb || true
}

if [ -f /tmp/freetube.deb ] && [ -s /tmp/freetube.deb ]; then
    echo "--> Installing FreeTube package..."
    apt-get install -y --no-install-recommends /tmp/freetube.deb || true
    rm -f /tmp/freetube.deb

    # Critical Electron Sandbox Permission Fix for Debian 13 Live ISO
    if [ -f /opt/FreeTube/chrome-sandbox ]; then
        echo "--> Setting setuid root permissions on /opt/FreeTube/chrome-sandbox..."
        chown root:root /opt/FreeTube/chrome-sandbox
        chmod 4755 /opt/FreeTube/chrome-sandbox
    fi
    echo "==> [MindSet Hook] FreeTube installed and sandbox secured successfully."
else
    echo "WARNING: FreeTube download was skipped or network was unreachable during build."
    echo "FreeTube can be installed post-boot via apt or downloaded from freetubeapp.io."
fi
