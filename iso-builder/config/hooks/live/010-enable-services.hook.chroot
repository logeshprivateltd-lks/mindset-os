#!/bin/sh
# ==============================================================================
# MindSet OS Live Hook: 010-enable-services.hook.chroot
# Enables NetworkManager, seatd, bluetooth, greetd, mindset-persist-init;
# configures locale, timezone, fonts, and session binary permissions.
# ==============================================================================
set -e

echo "==> [MindSet Hook] Enabling core Linux desktop services..."

mkdir -p /etc/NetworkManager
cat << 'EOF' > /etc/NetworkManager/NetworkManager.conf
[main]
plugins=ifupdown,keyfile

[ifupdown]
managed=true

[device]
wifi.scan-rand-mac-address=no
EOF

for svc in NetworkManager.service seatd.service bluetooth.service greetd.service mindset-persist-init.service qemu-guest-agent.service; do
    systemctl enable "${svc}" 2>/dev/null || true
done

cat << 'EOF' > /etc/os-release
PRETTY_NAME="MindSet OS 1.1 (by L.K.S)"
NAME="MindSet OS"
VERSION_ID="1.1"
VERSION="1.1 (L.K.S Student Edition)"
ID=mindsetos
HOME_URL="https://github.com/logeshprivateltd-lks/mindset-os"
SUPPORT_URL="https://github.com/logeshprivateltd-lks/mindset-os"
EOF

cat << 'EOF' > /etc/issue
MindSet OS 1.1 — Made by L.K.S Company \n \l

EOF

echo "mindset-os" > /etc/hostname
cat << 'EOF' > /etc/hosts
127.0.0.1       localhost
127.0.1.1       mindset-os
::1             localhost ip6-localhost ip6-loopback
EOF

echo "Asia/Kolkata" > /etc/timezone
ln -sf /usr/share/zoneinfo/Asia/Kolkata /etc/localtime

if [ -f /etc/locale.gen ]; then
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
    locale-gen || true
fi
cat << 'EOF' > /etc/default/locale
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8
EOF

: > /etc/motd
rm -f /etc/update-motd.d/* 2>/dev/null || true

if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f || true
fi

chmod +x /usr/local/bin/mindset-shell 2>/dev/null || true
chmod +x /usr/local/bin/mindset-os 2>/dev/null || true
chmod +x /usr/local/bin/mindset-session 2>/dev/null || true
chmod +x /usr/local/bin/mindset-x11-session 2>/dev/null || true
chmod +x /usr/local/bin/mindset-os-launch 2>/dev/null || true
chmod +x /usr/local/bin/mindset-persist-init 2>/dev/null || true
chmod +x /usr/local/bin/mindset-browser 2>/dev/null || true
chmod +x /usr/local/bin/mindset-setup-ollama 2>/dev/null || true
chmod +x /opt/mindset-os/bin/mindset-os 2>/dev/null || true

echo "==> [MindSet Hook] Services and OS branding enabled cleanly."
